{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "La scheda di un video",
  "type": "object",
  "additionalProperties": false,
  "required": ["titolo", "stato", "creato"],
  "properties": {
    "titolo": { "type": "string", "minLength": 1 },
    "stato": { "enum": ["proposta", "in lavorazione", "pronto", "pubblicato", "scartato"] },
    "creato": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "serie": { "type": "string" },
    "priorita": { "type": "integer", "minimum": 1 },
    "formato": { "enum": ["video", "carosello"] },
    "canali": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["tiktok", "instagram", "youtube", "x"] } },
    "proposta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggancio": { "type": "string" },
        "centro": { "type": "string" },
        "chiusa": { "type": "string" },
        "note": { "type": "string" },
        "quadro": { "type": "string", "minLength": 1 },
        "scene": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["animazione", "dalla"],
            "properties": {
              "animazione": { "type": ["string", "null"], "minLength": 1 },
              "dalla": { "type": "string", "minLength": 1 },
              "parole": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "spezzoni": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "prima"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "da": { "type": "number", "minimum": 0 },
              "a": { "type": "number", "exclusiveMinimum": 0 },
              "minuto": { "type": "string", "pattern": "^[0-9]{1,3}:[0-5][0-9]$" },
              "dice": { "type": "string", "minLength": 1 },
              "testo": { "type": "string", "minLength": 1 },
              "prima": { "type": "string", "minLength": 1 }
            },
            "dependentRequired": { "da": ["a"], "a": ["da"], "minuto": ["dice"], "dice": ["minuto"] },
            "oneOf": [{ "required": ["da"] }, { "required": ["dice"] }]
          }
        }
      }
    },
    "scaletta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apri"],
        "properties": {
          "apri": { "type": "string" },
          "fai": { "type": "string" },
          "spiega": { "type": "string" }
        }
      }
    },
    "didascalia": { "type": "string" },
    "hashtag": { "type": "array", "items": { "type": "string" } },
    "pubblicazioni": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canale", "data"],
        "properties": {
          "canale": { "type": "string" },
          "data": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "numeri": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "canale"],
        "properties": {
          "data": { "type": "string" },
          "canale": { "type": "string" },
          "visualizzazioni": { "type": "integer", "minimum": 0 },
          "mi_piace": { "type": "integer", "minimum": 0 },
          "commenti": { "type": "integer", "minimum": 0 },
          "condivisioni": { "type": "integer", "minimum": 0 },
          "salvati": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "da_verificare": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cosa", "stato"],
        "properties": {
          "cosa": { "type": "string" },
          "perche": { "type": "string" },
          "stato": { "enum": ["aperto", "a posto"] }
        }
      }
    },
    "note": { "type": "string" }
  }
}
